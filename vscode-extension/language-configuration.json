{
  "comments": {
    "lineComment": "*",
    "blockComment": ["/*", "*/"]
  },
  "brackets": [],
  "autoClosingPairs": [
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "'",
      "close": "'"
    }
  ],
  "surroundingPairs": [
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "'",
      "close": "'"
    }
  ],
  "folding": {
    "markers": {
      "start": null,
      "end": null
    }
  },
  "wordPattern": "(-?\\d*\\.\\d\\w*)|([^\\s\\"\\'()$,;{}<>])"
}
