DFHMSD TYPE=DATAENT,MAPSET=APPSET1,LANG=COBOL,PHYSICAL=YES
*
* DATAENT - Data Entry Screen
*
DFHMDI SIZE=(24,80)
*
* Define the map
DFHMND TYPE=MAP
*
* Header
DFHMND POS=(1,1),LENGTH=80,ATTRB=(PROT,INTENS),COLOR=WHITE,
       INITIAL='DATA ENTRY FORM - PLEASE FILL ALL FIELDS'
*
* Field labels
DFHMND POS=(3,1),LENGTH=10,ATTRB=(PROT),COLOR=GREEN,INITIAL='Customer:'
DFHMND POS=(5,1),LENGTH=10,ATTRB=(PROT),COLOR=GREEN,INITIAL='Order #:'
DFHMND POS=(7,1),LENGTH=10,ATTRB=(PROT),COLOR=GREEN,INITIAL='Amount:'
DFHMND POS=(9,1),LENGTH=10,ATTRB=(PROT),COLOR=GREEN,INITIAL='Date:'
DFHMND POS=(11,1),LENGTH=10,ATTRB=(PROT),COLOR=GREEN,INITIAL='Status:'
*
* Input fields
DFHMND POS=(3,12),LENGTH=20,ATTRB=(ALPH),COLOR=YELLOW
DFHMND POS=(5,12),LENGTH=10,ATTRB=(NUM),COLOR=YELLOW
DFHMND POS=(7,12),LENGTH=15,ATTRB=(NUM),COLOR=YELLOW,PIC='9(10)V99'
DFHMND POS=(9,12),LENGTH=10,ATTRB=(NORM),COLOR=YELLOW
DFHMND POS=(11,12),LENGTH=1,ATTRB=(ALPH),COLOR=YELLOW
*
* Action buttons
DFHMND POS=(15,30),LENGTH=10,ATTRB=(PROT),COLOR=GREEN,INITIAL='[F1=Help]'
DFHMND POS=(15,45),LENGTH=10,ATTRB=(PROT),COLOR=GREEN,INITIAL='[F3=Exit]'
DFHMND POS=(15,60),LENGTH=10,ATTRB=(PROT),COLOR=GREEN,INITIAL='[F12=Save]'
*
* Error message area
DFHMND POS=(17,1),LENGTH=80,ATTRB=(PROT),COLOR=RED
*
* Status line
DFHMND POS=(23,1),LENGTH=80,ATTRB=(PROT,REVERSE),COLOR=BLUE
