DFHMSD TYPE=MENU01,MAPSET=APPSET1,LANG=COBOL,PHYSICAL=YES
*
* MENU01 - Main application menu
*
DFHMDI SIZE=(24,80)
*
* Define the map
DFHMND TYPE=MAP
*
* Title
DFHMND POS=(1,25),LENGTH=30,ATTRB=(PROT,INTENS),COLOR=WHITE,
       INITIAL='COBOL BMS EDITOR DEMO'
*
* Menu options
DFHMND POS=(3,10),LENGTH=2,ATTRB=(PROT),COLOR=GREEN,INITIAL='1.'
DFHMND POS=(3,13),LENGTH=20,ATTRB=(PROT),COLOR=GREEN,
       INITIAL='Customer Maintenance'

DFHMND POS=(5,10),LENGTH=2,ATTRB=(PROT),COLOR=GREEN,INITIAL='2.'
DFHMND POS=(5,13),LENGTH=20,ATTRB=(PROT),COLOR=GREEN,
       INITIAL='Order Processing'

DFHMND POS=(7,10),LENGTH=2,ATTRB=(PROT),COLOR=GREEN,INITIAL='3.'
DFHMND POS=(7,13),LENGTH=20,ATTRB=(PROT),COLOR=GREEN,
       INITIAL='Inventory Management'

DFHMND POS=(9,10),LENGTH=2,ATTRB=(PROT),COLOR=GREEN,INITIAL='4.'
DFHMND POS=(9,13),LENGTH=20,ATTRB=(PROT),COLOR=GREEN,
       INITIAL='Reports'

DFHMND POS=(11,10),LENGTH=2,ATTRB=(PROT),COLOR=GREEN,INITIAL='5.'
DFHMND POS=(11,13),LENGTH=20,ATTRB=(PROT),COLOR=GREEN,
       INITIAL='Exit'
*
* Selection field (input)
DFHMND POS=(13,10),LENGTH=1,ATTRB=(NUM,INTENS),COLOR=YELLOW
*
* Instructions
DFHMND POS=(15,10),LENGTH=50,ATTRB=(PROT),COLOR=WHITE,
       INITIAL='Enter selection (1-5) and press ENTER'
*
* Status line
DFHMND POS=(23,1),LENGTH=80,ATTRB=(PROT,REVERSE),COLOR=BLUE
